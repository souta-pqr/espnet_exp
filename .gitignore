!egs2/cejc/asr1/myconf/.gen_pool_attn-frame2-blk42xh2ep40_same_n5_p30.yaml
!egs2/cejc/asr1/myconf/.gen_pool_attn-frame2-blk60_same_n5_p30.yaml
!egs2/cejc/asr1/myconf/.gen_pool_attn-frame2-blk60xh2_same_n5_p30.yaml
