# 音声・特徴量・学習成果物は一切コミットしない
# （末尾 / はディレクトリにしか一致しないため、symlink 用に / 無しも書く）
data/
dump/
exp/
feats/
tt_eval_logs/
tt_analysis/
egs2/*/*/data
egs2/*/*/dump
egs2/*/*/exp
egs2/*/*/feats
*.ark
*.scp
*.flac
*.wav
*.pth

# 実行時に生成される config（run_*.sh が sed で作る）
egs2/*/*/myconf/.gen_*.yaml

# Python
__pycache__/
*.pyc
*.pyo

# バックアップ
*.backup
*.backup[0-9]
*.bak
*.broken
*.orig

# 実験で実際に使った（手で直した）config は残す
!egs2/cejc/asr1/myconf/.gen_pool_attn-frame2-blk42_same_n5_p30.yaml
!egs2/cejc/asr1/myconf/.gen_pool_attn-frame2-blk42ep40_same_n5_p30.yaml
